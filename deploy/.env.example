# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不可 commit。

# 對外網域（Caddy 自動申請 HTTPS）。用 VM 的外部 IP 把 . 換成 -，加上 .sslip.io
# 例：外部 IP 34.80.1.2 → 34-80-1-2.sslip.io
SITE_ADDRESS=34-80-1-2.sslip.io

# SQL Server sa 密碼（至少 8 字元，需含大小寫、數字、符號）
DB_PASSWORD=ChangeMe_Str0ng!

# JWT 簽章金鑰（隨機長字串，例如：openssl rand -base64 48）
JWT_SECRET=

# 藍新金流憑證加密主金鑰（至少 32 字元的隨機字串）
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# 管理員：資料庫腳本已內建 admin@marketday.local，部署時請保持 ADMIN_EMAIL 留空。
# 注意：若自行設定 ADMIN_EMAIL，後端只會建立 users 資料列、不會建立 admin_profiles，
# 該帳號登入後所有管理員寫入操作都會回「找不到該管理員」（原專案行為，詳見 README）。
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# 以下可留空（留空則對應功能無法使用）
GOOGLE_CLIENT_ID=
MAIL_USERNAME=
MAIL_PASSWORD=
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=

# 前端來源（預設即為你的 fork）
# FRONTEND_REPO=https://github.com/lin80092091/market_day.git
# FRONTEND_REF=feature/batch-user-status
