# SITE_ADDRESS 由 .env 提供，例如 34-80-1-2.sslip.io（Caddy 會自動向 Let's Encrypt 申請憑證）
{$SITE_ADDRESS} {
	encode gzip

	# 後端 API、上傳圖片、Swagger 轉給 Spring Boot。
	# 注意：必須用 handle 包起來，否則 Caddy 的指令排序會讓下面的 catch-all handle 先接走所有請求。
	@backend path /api/* /images/* /swagger-ui/* /v3/api-docs*
	handle @backend {
		reverse_proxy api:8081
	}

	# 其餘為 Angular 靜態檔；找不到的路徑回 index.html（SPA 路由）
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
